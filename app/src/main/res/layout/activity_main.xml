<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PÁDEL"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Zona central dividida en dos marcadores táctiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Lado Equipo A -->
        <LinearLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#224CAF50"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQ A"
                android:textColor="#4CAF50"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lado Equipo B -->
        <LinearLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#222196F3"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQ B"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Botón pequeño de reinicio -->
    <TextView
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESET"
        android:textColor="#FF5252"
        android:textSize="10sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="4dp" />

</LinearLayout>
