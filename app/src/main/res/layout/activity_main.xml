<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:keepScreenOn="true">

    <!-- Marcador Principal -->
    <LinearLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="2">

        <!-- Equipo A (Arriba/Izquierda) -->
        <FrameLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSetsA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS: 0  JUEGOS: 0"
                    android:textColor="#81C784"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScoreA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#81C784"
                    android:textSize="80sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#222222" />

        <!-- Equipo B (Abajo/Derecha) -->
        <FrameLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSetsB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS: 0  JUEGOS: 0"
                    android:textColor="#64B5F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScoreB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#64B5F6"
                    android:textSize="80sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Modal de Selección de Modo (Overlay) -->
    <LinearLayout
        android:id="@+id/layoutModeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EF050505"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona el modo de juego"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPuntoOro"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PUNTO DE ORO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FFCA28"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVentaja"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="VENTAJA (VENTAJA/DEUCE)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
