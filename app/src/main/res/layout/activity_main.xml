<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:keepScreenOn="true">

    <!-- Contenido del Marcador Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Equipo 1 (Izquierda - Verde) -->
        <LinearLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSetsA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET:0 JUEGO:0"
                android:textColor="#81C784"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#81C784"
                android:textSize="140sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Línea Divisoria Vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#222222" />

        <!-- Equipo 2 (Derecha - Azul) -->
        <LinearLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSetsB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET:0 JUEGO:0"
                android:textColor="#64B5F6"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#64B5F6"
                android:textSize="140sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay Selección de Modo Inicial en Móvil -->
    <LinearLayout
        android:id="@+id/layoutMainModeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA050505"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona Modo de Juego"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMainModeNormal"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:text="Ventaja"
                android:textSize="16sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/btnMainModeGold"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:text="Punto de Oro"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
