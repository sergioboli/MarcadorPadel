<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#050505"
    android:keepScreenOn="true">

    <!-- Equipo 1 (Izquierda - Verde) -->
    <LinearLayout
        android:id="@+id/layoutTeamA"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#154CAF50"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp">

        <!-- Sets y Juegos ENCIMA de los puntos -->
        <TextView
            android:id="@+id/tvSetsA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SET:0 JUEGO:0"
            android:textColor="#81C784"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Puntuación Gigante (Doble de tamaño) -->
        <TextView
            android:id="@+id/tvScoreA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#81C784"
            android:textSize="160sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Línea Divisoria Vertical -->
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="#222222" />

    <!-- Equipo 2 (Derecha - Azul) -->
    <LinearLayout
        android:id="@+id/layoutTeamB"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#152196F3"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp">

        <!-- Sets y Juegos ENCIMA de los puntos -->
        <TextView
            android:id="@+id/tvSetsB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SET:0 JUEGO:0"
            android:textColor="#64B5F6"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Puntuación Gigante (Doble de tamaño) -->
        <TextView
            android:id="@+id/tvScoreB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#64B5F6"
            android:textSize="160sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
