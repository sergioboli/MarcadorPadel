            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScoreB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
