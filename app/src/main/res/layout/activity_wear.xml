<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- Capa del Marcador Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Equipo A (Izquierda / Arriba) -->
        <LinearLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSetsA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S:0 J:0"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Línea separadora -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#333333" />

        <!-- Equipo B (Derecha / Abajo) -->
        <LinearLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSetsB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S:0 J:0"
                android:textColor="#64B5F6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Superposición de Selección de Modo (Punto de Oro / Normal) -->
    <LinearLayout
        android:id="@+id/layoutWearModeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo de juego"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnWearModeNormal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Ventaja"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnWearModeGold"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:text="Punto de Oro"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</FrameLayout>
