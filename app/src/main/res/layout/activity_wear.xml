<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Lado Izquierdo -->
        <LinearLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSetsA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S:0 J:0"
                android:textColor="#81C784"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lado Derecho -->
        <LinearLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSetsB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S:0 J:0"
                android:textColor="#64B5F6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESET"
        android:textColor="#FF5252"
        android:textSize="9sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>
