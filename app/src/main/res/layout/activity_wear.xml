<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/layoutWearMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="2"
        android:visibility="gone">

        <!-- Equipo A -->
        <FrameLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScoreA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#81C784"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvSetsA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS: 0\nJUEGOS: 0"
                    android:textColor="#81C784"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222222" />

        <!-- Equipo B -->
        <FrameLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScoreB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#64B5F6"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvSetsB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETS: 0\nJUEGOS: 0"
                    android:textColor="#64B5F6"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWearWaiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Conectando..."
        android:textColor="#FFCA28"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="visible" />

</FrameLayout>
