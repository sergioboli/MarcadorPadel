<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:keepScreenOn="true">

    <!-- Contenido Principal Marcador Reloj -->
    <LinearLayout
        android:id="@+id/layoutWearMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Equipo A (Izquierda - Verde) -->
        <LinearLayout
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#154CAF50"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvSetsA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET:0\nJUEGO:0"
                android:textColor="#81C784"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#81C784"
                android:textSize="55sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divisor Vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#222222" />

        <!-- Equipo B (Derecha - Azul) -->
        <LinearLayout
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#152196F3"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvSetsB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET:0\nJUEGO:0"
                android:textColor="#64B5F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#64B5F6"
                android:textSize="55sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mensaje de Espera si aún no se ha elegido modo en el móvil -->
    <TextView
        android:id="@+id/tvWearWaiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Selecciona modo\nen el móvil"
        android:textColor="#FFCA28"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="visible" />

</FrameLayout>
